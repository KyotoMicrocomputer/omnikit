				</instance-parameter>
				<parameter name="builder" transfer-ownership="none">
					<type name="Omni.PipelineBuilder" c:type="OmniPipelineBuilder*"/>
				</parameter>
			</parameters>
		</method>
		<virtual-method name="add_to_pipeline" invoker="add_to_pipeline" throws="1">
