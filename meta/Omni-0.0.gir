		</member>
		<member name="not_empty" c:identifier="OMNI_STREAM_STATE_FLAGS_NOT_EMPTY" value="8">
			<doc xml:whitespace="preserve" filename="" line="0">The stream's time range is not empty (`fSTR ∩ mSTR ≠ ∅`).</doc>
		</member>
	</bitfield>
	<bitfield name="LinkPolicyFlags" c:type="OmniLinkPolicyFlags" glib:type-name="OmniLinkPolicyFlags" glib:get-type="omni_link_policy_flags_get_type">
		<doc xml:whitespace="preserve" filename="" line="0">A set of flags indicating properties of a port property.

