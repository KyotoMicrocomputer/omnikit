	<interface name="RichSummaryBuilder" c:type="OmniRichSummaryBuilder" c:symbol-prefix="rich_summary_builder" glib:type-name="OmniRichSummaryBuilder" glib:get-type="omni_rich_summary_builder_get_type" glib:type-struct="RichSummaryBuilderIface">
		<doc xml:whitespace="preserve" filename="" line="0">Defines a rich summary view.</doc>
